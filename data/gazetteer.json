  "_schema": {
    "_about": "Topographia Sacra · canonical gazetteer across all books in the series. Each entry is a place named in scripture, keyed by a stable lowercase slug. Edit this file to revise identifications across the whole series; chapter pages read from it at load.",
    "fields": {
      "name": "Display name (English form, as used by Anchor Bible Dictionary)",
      "name_alt": "Alternative names or transliterations, optional, for search/index",
      "coords": "[latitude, longitude] of the leading identification, decimal degrees, WGS84",
      "tier": "identified | probable | conjectural | unknown",
      "id": "Brief geographical/archaeological identification, ~1–3 sentences",
      "abd": "Anchor Bible Dictionary reference (vol:page, e.g. '3:721')",
      "alternatives": "Optional array of {site, source} for disputed identifications; cite footnote in chapter data",
      "appearances": "Array of {book, chapter, verses} where the place is named"
    },
    "tier_meanings": {
      "identified": "Scholarly consensus, archaeological confirmation",
      "probable": "Leading candidate, some scholarly dispute",
      "conjectural": "Best guess, multiple candidates, or general region only",
      "unknown": "Named but unlocatable; should NOT appear on a map — list only in gazetteer"
    }
  },
